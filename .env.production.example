# ==================== REQUIRED ====================
NODE_ENV=production
PORT=3000
APP_URL=https://api.voxo.uz
ADMIN_URL=https://admin.voxo.uz
CORS_ORIGINS=https://admin.voxo.uz,voxo://app

# Database
DATABASE_URL=postgresql://voxo:CHANGE_ME@postgres:5432/voxo

# Redis
REDIS_URL=redis://:CHANGE_ME@redis:6379

# JWT (generate with: openssl rand -hex 64)
JWT_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ==================== AUTH PROVIDERS ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ==================== PAYMENT PROVIDERS ====================
# Click
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# Payme
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
# Uzum Bank
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
# Google Play
GOOGLE_PLAY_PACKAGE_NAME=com.voxo.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_PLAY_MOCK_VERIFY=false

# ==================== STORAGE ====================
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=voxo
S3_PUBLIC_URL=https://cdn.voxo.uz

# ==================== PUSH NOTIFICATIONS ====================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==================== VOICE / ZEGOCLOUD ====================
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
ZEGOCLOUD_APP_ID=
ZEGOCLOUD_SERVER_SECRET=

# ==================== DOCKER ====================
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_min_8_chars
NEXTAUTH_SECRET=CHANGE_ME_min_32_chars
IMAGE_TAG=latest

# ==================== OPTIONAL ====================
BCRYPT_ROUNDS=10
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=info
SENTRY_DSN=
ADMIN_EMAIL=admin@voxo.uz
ADMIN_PASSWORD=CHANGE_ME
