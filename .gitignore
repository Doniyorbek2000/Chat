*.p12
*.mobileprovision
*.cer
*.certSigningRequest
GoogleService-Info.plist
google-services.json
firebase-adminsdk*.json
service-account*.json

# ==================== BACKUPS ====================
backups/
*.sql.gz
*.dump

# ==================== TEST COVERAGE ====================
coverage/
lcov.info
