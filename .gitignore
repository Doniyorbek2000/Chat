# ==================== NODE.JS ====================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
lerna-debug.log*

# ==================== BUILD OUTPUTS ====================
dist/
build/
out/
.output/

# ==================== ENVIRONMENT FILES ====================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.prod
.env.staging
# Keep examples
!.env.example

# ==================== NEXT.JS ====================
.next/
.vercel
next-env.d.ts

# ==================== TYPESCRIPT ====================
*.tsbuildinfo

# ==================== PRISMA ====================
# Keep schema and migrations, ignore generated client
backend/node_modules/.prisma/
backend/generated/

# ==================== LOGS ====================
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==================== FLUTTER / DART ====================
# Build outputs
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.pub-cache/
mobile/.pub/

# Flutter generated files
mobile/**/*.g.dart
mobile/**/*.freezed.dart
mobile/**/*.gr.dart
mobile/**/*.config.dart
# Keep generated dir markers
!mobile/**/.gitkeep

# iOS
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Runner/GeneratedPluginRegistrant.*
mobile/ios/Flutter/ephemeral/
mobile/ios/**/*.xcworkspace
!mobile/ios/Runner.xcworkspace
mobile/ios/**/*.xcuserstate

# Android
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
mobile/android/upload-keystore.jks
mobile/android/*.jks
mobile/android/*.keystore
mobile/android/app/keystore.jks
mobile/android/**/GeneratedPluginRegistrant.java
mobile/android/captures/
mobile/android/gradlew
mobile/android/gradlew.bat

# macOS
mobile/macos/Pods/
mobile/macos/Flutter/GeneratedPluginRegistrant.swift
mobile/macos/Flutter/ephemeral/

# ==================== DOCKER ====================
# Ignore docker secrets but not compose files
.docker-secrets/
docker-secrets/
*.pem
# Keep compose files
!docker-compose*.yml
!Dockerfile*

# ==================== IDE FILES ====================
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# VSCode - keep shared settings, ignore personal
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.history/

# Xcode
xcuserdata/
*.xcscmblueprint
*.xccheckout
DerivedData/
*.moved-aside
*.pbxuser
*.perspectivev3

# ==================== OS FILES ====================
.DS_Store
.DS_Store?
._*
.Spotlight-V3
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

