# ==================== App ====================
NODE_ENV=development
PORT=3000
APP_NAME=VOXO
APP_BASE_URL=http://localhost:3000

# ==================== Database ====================
DATABASE_URL=postgresql://voxo:voxo_secure_password@localhost:5432/voxo

# ==================== Redis ====================
REDIS_URL=redis://:redis_password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# ==================== JWT ====================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ==================== Google OAuth ====================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==================== Apple Sign In ====================
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key

# ==================== MinIO / S3 ====================
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=voxo
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/voxo

# ==================== ZEGOCLOUD ====================
ZEGOCLOUD_APP_ID=your-zegocloud-app-id
ZEGOCLOUD_SERVER_SECRET=your-zegocloud-server-secret

# ==================== Click Payment ====================
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SERVICE_ID=your-click-service-id
CLICK_SECRET_KEY=your-click-secret-key
CLICK_MERCHANT_USER_ID=your-click-merchant-user-id

# ==================== Payme ====================
PAYME_MERCHANT_ID=your-payme-merchant-id
PAYME_KEY=your-payme-key
PAYME_TEST_KEY=your-payme-test-key
PAYME_ENDPOINT=https://checkout.paycom.uz/api

# ==================== Uzum Bank ====================
UZUM_MERCHANT_ID=your-uzum-merchant-id
UZUM_SECRET_KEY=your-uzum-secret-key

# ==================== Firebase (FCM) ====================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ==================== Admin ====================
ADMIN_EMAIL=admin@voxo.app
ADMIN_PASSWORD=change-me-on-first-login

# ==================== Rate Limiting ====================
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:3001,https://admin.voxo.app,voxo://app
