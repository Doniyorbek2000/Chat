# ============================================================
# VOXO Backend — Environment Variables Example
# Copy to .env and fill in real values before running the app
# ============================================================

# --- App ---
APP_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/voxo_db

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# --- Google Auth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Apple Auth ---
APPLE_CLIENT_ID=com.yourcompany.voxo
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Click Payment ---
CLICK_SERVICE_ID=12345
CLICK_MERCHANT_ID=67890
CLICK_SECRET_KEY=your-click-secret-key
CLICK_MERCHANT_USER_ID=your-click-merchant-user-id

# --- Payme Payment ---
PAYME_MERCHANT_ID=your-payme-merchant-id
PAYME_KEY=your-payme-key
PAYME_TEST_KEY=your-payme-test-key
PAYME_ENDPOINT=https://checkout.paycom.uz/api

# --- Uzum Payment ---
UZUM_MERCHANT_ID=your-uzum-merchant-id
UZUM_SECRET_KEY=your-uzum-secret-key

# --- Google Play ---
GOOGLE_PLAY_PACKAGE_NAME=com.yourcompany.voxo
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=voxo
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Firebase (Push Notifications) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# --- ZegoCloud (Voice/Video) ---
ZEGOCLOUD_APP_ID=1234567890
ZEGOCLOUD_SERVER_SECRET=your-zegocloud-server-secret

# --- Throttle ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Upload ---
UPLOAD_MAX_SIZE_MB=5
