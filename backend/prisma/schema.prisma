// VOXO Platform - Complete Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum TransactionType {
  RECHARGE
  GIFT_SEND
  GIFT_RECEIVE
  TRANSFER
  WITHDRAW
  REWARD
  REFUND
  VIP_PURCHASE
  VEHICLE_PURCHASE
  FRAME_PURCHASE
}

enum Currency {
  COINS
  DIAMONDS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum RoomType {
  PUBLIC
  PRIVATE
  PASSWORD
  FAMILY
  VIP
}

enum RoomMemberRole {
  HOST
  CO_HOST
  ADMIN
  SPEAKER
  LISTENER
}

enum GiftCategory {
  NORMAL
  LUXURY
  COUPLE
  FAMILY
  LUCKY
  VIP
  NATION
}

enum GiftType {
  STATIC
  LOTTIE
  SVGA
  FULLSCREEN
}

enum FamilyMemberRole {
  OWNER
  CO_OWNER
  ADMIN
  MEMBER
}

enum CoupleStatus {
  ACTIVE
  ENDED
}

enum CoupleRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BattleStatus {
  PENDING
  ACTIVE
  ENDED
  CANCELLED
}

enum ChatType {
  TEXT
  VOICE
  IMAGE
  EMOJI
  GIFT
}

enum ReportTargetType {
  USER
  ROOM
  MESSAGE
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum BanType {
  ROOM
  PLATFORM
  DEVICE
  IP
}

enum WithdrawalMethod {
  CLICK
  PAYME
  BANK
  UZUM
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
}

enum VehicleLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  LEGENDARY
}

enum FrameType {
  AVATAR
  MIC
  CHAT_BUBBLE
}

enum AgencyMemberRole {
  OWNER
  MANAGER
  MEMBER
}

enum EventType {
  GIFT_COMPETITION
  RECHARGE_COMPETITION
  LUCKY_GIFT
  DAILY_TASK
  SEASONAL
}

enum LinkType {
  ROOM
  USER
  FAMILY
  EVENT
  EXTERNAL
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  MODERATOR
}

// ==================== USER ====================

model User {
  id            String    @id @default(cuid())
  phone         String?   @unique
  email         String?   @unique
  googleId      String?   @unique
  appleId       String?   @unique
  username      String?   @unique
  displayName   String?
  avatar        String?
  coverImage    String?
  bio           String?
  uid           String    @unique
  level         Int       @default(1)
  xp            Int       @default(0)
  isVip         Boolean   @default(false)
  vipLevel      Int       @default(0)
  vipExpiresAt  DateTime?
  isOnline      Boolean   @default(false)
  lastSeen      DateTime?
  country       String?
  language      String    @default("uz")
  referralCode  String?   @unique
  referredBy    String?
  isVerified    Boolean   @default(false)
  isBanned      Boolean   @default(false)
  banReason     String?
  bannedUntil   DateTime?
  deviceId      String?
  ipAddress     String?
  role          UserRole  @default(USER)
  fcmToken      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  wallet               Wallet?
  transactions         Transaction[]
  hostedRooms          VoiceRoom[]           @relation("RoomHost")
  roomSeats            RoomSeat[]
  roomMemberships      RoomMember[]
  sentGifts            GiftTransaction[]     @relation("GiftSender")
  receivedGifts        GiftTransaction[]     @relation("GiftReceiver")
  ownedFamily          Family?               @relation("FamilyOwner")
  familyMemberships    FamilyMember[]
  coupleAsUser1        Couple[]              @relation("CoupleUser1")
  coupleAsUser2        Couple[]              @relation("CoupleUser2")
  sentCoupleRequests   CoupleRequest[]       @relation("CoupleRequestSender")
  receivedCoupleRequests CoupleRequest[]     @relation("CoupleRequestReceiver")
  followers            Follow[]              @relation("Following")
  following            Follow[]              @relation("Follower")
  sentChats            Chat[]                @relation("ChatSender")
  receivedChats        Chat[]                @relation("ChatReceiver")
  notifications        Notification[]
  reports              Report[]              @relation("Reporter")
  bans                 Ban[]                 @relation("BannedUser")
  adminBans            Ban[]                 @relation("AdminUser")
  ownedAgency          Agency?               @relation("AgencyOwner")
  agencyMemberships    AgencyMember[]
  withdrawals          Withdrawal[]
  dailyRewards         DailyReward[]
  achievements         UserAchievement[]
  vipSubscriptions     UserVip[]
  vehicles             UserVehicle[]
  frames               UserFrame[]
  resolvedReports      Report[]              @relation("ReportResolver")
  processedWithdrawals Withdrawal[]          @relation("WithdrawalProcessor")

  @@index([phone])
  @@index([email])
  @@index([uid])
  @@index([username])
  @@index([country])
  @@index([isOnline])
  @@map("users")
}

// ==================== WALLET ====================

model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  coins          BigInt   @default(0)
  diamonds       BigInt   @default(0)
  totalRecharge  BigInt   @default(0)
  totalGifted    BigInt   @default(0)
  totalEarned    BigInt   @default(0)
  totalWithdrawn BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  type          TransactionType
  currency      Currency
  amount        BigInt
  balanceBefore BigInt
  balanceAfter  BigInt
  referenceId   String?
  referenceType String?
  description   String?
  status        TransactionStatus @default(COMPLETED)
  metadata      Json?
  createdAt     DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
  @@map("transactions")
}

// ==================== VIP ====================

model VipPlan {
  id             String   @id @default(cuid())
  level          Int      @unique
  name           String
  price          Int
  currency       Currency
  duration       Int
  features       Json
  frameUrl       String?
  entryEffectUrl String?
  chatBubbleUrl  String?
  isActive       Boolean  @default(true)

  subscriptions UserVip[]

  @@map("vip_plans")
}

model UserVip {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  level     Int
  startedAt DateTime @default(now())
  expiresAt DateTime
  isActive  Boolean  @default(true)

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan VipPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("user_vips")
}

// ==================== VOICE ROOMS ====================

model VoiceRoom {
  id           String   @id @default(cuid())
  hostId       String
  title        String
  description  String?
  coverImage   String?
  type         RoomType @default(PUBLIC)
  password     String?
  maxSeats     Int      @default(8)
  currentSeats Int      @default(0)
  tags         String[]
  region       String?
  announcement String?
  isLocked     Boolean  @default(false)
  isLive       Boolean  @default(true)
  totalGifts   BigInt   @default(0)
  viewerCount  Int      @default(0)
  familyId     String?
  pkBattleId   String?
  language     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  host    User         @relation("RoomHost", fields: [hostId], references: [id])
  family  Family?      @relation(fields: [familyId], references: [id])
  seats   RoomSeat[]
  members RoomMember[]
  gifts   GiftTransaction[]
  pkBattlesAsRoom1 PkBattle[] @relation("PkRoom1")
  pkBattlesAsRoom2 PkBattle[] @relation("PkRoom2")

  @@index([hostId])
  @@index([type])
  @@index([isLive])
  @@index([region])
  @@index([familyId])
  @@map("voice_rooms")
}

model RoomSeat {
  id        String    @id @default(cuid())
  roomId    String
  position  Int
  userId    String?
  isMuted   Boolean   @default(false)
  isLocked  Boolean   @default(false)
  invitedBy String?
  joinedAt  DateTime?

  room VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User?     @relation(fields: [userId], references: [id])

  @@unique([roomId, position])
  @@index([roomId])
  @@index([userId])
  @@map("room_seats")
}

model RoomMember {
  id         String         @id @default(cuid())
  roomId     String
  userId     String
  role       RoomMemberRole @default(LISTENER)
  joinedAt   DateTime       @default(now())
  leftAt     DateTime?
  giftsSent  BigInt         @default(0)
  totalTime  Int            @default(0)

  room VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])

  @@index([roomId])
  @@index([userId])
  @@index([joinedAt])
  @@map("room_members")
}

// ==================== GIFTS ====================

model Gift {
  id            String       @id @default(cuid())
  name          String
  category      GiftCategory @default(NORMAL)
  type          GiftType     @default(STATIC)
  imageUrl      String
  animationUrl  String?
  coinPrice     Int
  diamondPrice  Int          @default(0)
  description   String?
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)

  transactions GiftTransaction[]

  @@index([category])
  @@index([isActive])
  @@map("gifts")
}

model GiftTransaction {
  id            String   @id @default(cuid())
  senderId      String
  receiverId    String
  roomId        String?
  giftId        String
  quantity      Int      @default(1)
  totalCoins    BigInt
  totalDiamonds BigInt   @default(0)
  message       String?
  multiplier    Float    @default(1.0)
  createdAt     DateTime @default(now())

  sender   User       @relation("GiftSender", fields: [senderId], references: [id])
  receiver User       @relation("GiftReceiver", fields: [receiverId], references: [id])
  room     VoiceRoom? @relation(fields: [roomId], references: [id])
  gift     Gift       @relation(fields: [giftId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([roomId])
  @@index([createdAt])
  @@map("gift_transactions")
}

// ==================== FAMILY ====================

model Family {
  id              String   @id @default(cuid())
  name            String   @unique
  tag             String   @unique
  description     String?
  avatar          String?
  coverImage      String?
  announcement    String?
  level           Int      @default(1)
  xp              BigInt   @default(0)
  treasury        BigInt   @default(0)
  ownerId         String
  isPublic        Boolean  @default(true)
  requireApproval Boolean  @default(false)
  maxMembers      Int      @default(50)
  country         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner   User           @relation("FamilyOwner", fields: [ownerId], references: [id])
  members FamilyMember[]
  rooms   VoiceRoom[]
  battlesAsChallenger FamilyBattle[] @relation("FamilyChallenger")
  battlesAsDefender   FamilyBattle[] @relation("FamilyDefender")

  @@index([ownerId])
  @@index([country])
  @@map("families")
}

model FamilyMember {
  id           String           @id @default(cuid())
  familyId     String
  userId       String
  role         FamilyMemberRole @default(MEMBER)
  joinedAt     DateTime         @default(now())
  contribution BigInt           @default(0)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([familyId, userId])
  @@index([familyId])
  @@index([userId])
  @@map("family_members")
}

model FamilyBattle {
  id                 String       @id @default(cuid())
  challengerFamilyId String
  defenderFamilyId   String
  startTime          DateTime
  endTime            DateTime
  status             BattleStatus @default(PENDING)
  challengerScore    BigInt       @default(0)
  defenderScore      BigInt       @default(0)
  winnerId           String?
  prizePool          BigInt       @default(0)
  createdAt          DateTime     @default(now())

  challengerFamily Family @relation("FamilyChallenger", fields: [challengerFamilyId], references: [id])
  defenderFamily   Family @relation("FamilyDefender", fields: [defenderFamilyId], references: [id])

  @@index([challengerFamilyId])
  @@index([defenderFamilyId])
  @@index([status])
  @@map("family_battles")
}

// ==================== COUPLE ====================

model Couple {
  id              String       @id @default(cuid())
  user1Id         String
  user2Id         String
  level           Int          @default(1)
  xp              BigInt       @default(0)
  anniversaryDate DateTime?
  status          CoupleStatus @default(ACTIVE)
  endedAt         DateTime?
  endedBy         String?
  endReason       String?
  createdAt       DateTime     @default(now())

  user1 User @relation("CoupleUser1", fields: [user1Id], references: [id])
  user2 User @relation("CoupleUser2", fields: [user2Id], references: [id])

  @@index([user1Id])
  @@index([user2Id])
  @@map("couples")
}

model CoupleRequest {
  id         String              @id @default(cuid())
  senderId   String
  receiverId String
  status     CoupleRequestStatus @default(PENDING)
  message    String?
  createdAt  DateTime            @default(now())

  sender   User @relation("CoupleRequestSender", fields: [senderId], references: [id])
  receiver User @relation("CoupleRequestReceiver", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@map("couple_requests")
}

// ==================== PK BATTLE ====================

model PkBattle {
  id          String       @id @default(cuid())
  room1Id     String
  room2Id     String
  startTime   DateTime?
  endTime     DateTime?
  duration    Int          @default(300)
  status      BattleStatus @default(PENDING)
  room1Score  BigInt       @default(0)
  room2Score  BigInt       @default(0)
  winnerId    String?
  createdAt   DateTime     @default(now())

  room1 VoiceRoom @relation("PkRoom1", fields: [room1Id], references: [id])
  room2 VoiceRoom @relation("PkRoom2", fields: [room2Id], references: [id])

  @@index([room1Id])
  @@index([room2Id])
  @@index([status])
  @@map("pk_battles")
}

// ==================== SOCIAL ====================

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// ==================== CHAT ====================

model Chat {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  content    String?
  type       ChatType  @default(TEXT)
  mediaUrl   String?
  duration   Int?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  sender   User @relation("ChatSender", fields: [senderId], references: [id])
  receiver User @relation("ChatReceiver", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
  @@index([createdAt])
  @@map("chats")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ==================== MODERATION ====================

model Report {
  id          String           @id @default(cuid())
  reporterId  String
  targetId    String
  targetType  ReportTargetType
  reason      String
  description String?
  evidence    Json?
  status      ReportStatus     @default(PENDING)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())

  reporter User  @relation("Reporter", fields: [reporterId], references: [id])
  resolver User? @relation("ReportResolver", fields: [resolvedBy], references: [id])

  @@index([reporterId])
  @@index([targetId])
  @@index([status])
  @@map("reports")
}

model Ban {
  id          String    @id @default(cuid())
  userId      String
  adminId     String
  type        BanType
  reason      String
  bannedUntil DateTime?
  isPermanent Boolean   @default(false)
  roomId      String?
  deviceId    String?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  user  User @relation("BannedUser", fields: [userId], references: [id])
  admin User @relation("AdminUser", fields: [adminId], references: [id])

  @@index([userId])
  @@index([type])
  @@map("bans")
}

// ==================== AGENCY ====================

model Agency {
  id            String   @id @default(cuid())
  name          String   @unique
  logo          String?
  description   String?
  ownerId       String   @unique
  level         Int      @default(1)
  commission    Float    @default(20.0)
  totalEarnings BigInt   @default(0)
  memberCount   Int      @default(0)
  country       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner   User           @relation("AgencyOwner", fields: [ownerId], references: [id])
  members AgencyMember[]

  @@index([country])
  @@map("agencies")
}

model AgencyMember {
  id            String           @id @default(cuid())
  agencyId      String
  userId        String
  role          AgencyMemberRole @default(MEMBER)
  joinedAt      DateTime         @default(now())
  totalEarnings BigInt           @default(0)
  commission    Float            @default(0)

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([agencyId, userId])
  @@index([agencyId])
  @@index([userId])
  @@map("agency_members")
}

// ==================== PAYMENTS ====================

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  amount        BigInt
  currency      Currency
  method        WithdrawalMethod
  accountNumber String
  accountName   String
  status        WithdrawalStatus @default(PENDING)
  processedBy   String?
  processedAt   DateTime?
  txId          String?
  note          String?
  createdAt     DateTime         @default(now())

  user      User  @relation(fields: [userId], references: [id])
  processor User? @relation("WithdrawalProcessor", fields: [processedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

// ==================== GAMIFICATION ====================

model DailyReward {
  id        String   @id @default(cuid())
  userId    String
  day       Int
  reward    Json
  claimed   Boolean  @default(false)
  claimedAt DateTime?
  date      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
  @@map("daily_rewards")
}

model Achievement {
  id              String  @id @default(cuid())
  name            String  @unique
  description     String
  icon            String
  type            String
  requirement     Int
  rewardCoins     Int     @default(0)
  rewardDiamonds  Int     @default(0)
  isActive        Boolean @default(true)

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  progress      Int       @default(0)
  completed     Boolean   @default(false)
  completedAt   DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// ==================== EVENTS ====================

model Event {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        EventType
  startDate   DateTime
  endDate     DateTime
  banner      String?
  rewards     Json
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([isActive])
  @@index([startDate, endDate])
  @@map("events")
}

// ==================== BANNERS ====================

model Banner {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  linkType  LinkType?
  linkValue String?
  position  String    @default("HOME")
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  @@index([isActive])
  @@index([position])
  @@map("banners")
}

// ==================== VEHICLES ====================

model Vehicle {
  id           String       @id @default(cuid())
  name         String
  level        VehicleLevel
  animationUrl String
  previewUrl   String?
  coinPrice    Int
  duration     Int          @default(30)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  userVehicles UserVehicle[]

  @@index([level])
  @@map("vehicles")
}

model UserVehicle {
  id        String    @id @default(cuid())
  userId    String
  vehicleId String
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([userId, vehicleId])
  @@index([userId])
  @@index([expiresAt])
  @@map("user_vehicles")
}

// ==================== FRAMES ====================

model Frame {
  id        String    @id @default(cuid())
  name      String
  type      FrameType
  imageUrl  String
  level     Int       @default(0)
  coinPrice Int
  duration  Int       @default(30)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  userFrames UserFrame[]

  @@index([type])
  @@map("frames")
}

model UserFrame {
  id        String    @id @default(cuid())
  userId    String
  frameId   String
  isActive  Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  frame Frame @relation(fields: [frameId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("user_frames")
}

// ==================== AUDIT ====================

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}
